---
import '../styles/global.css'
import PlayerNav from '../components/PlayerNav'

type Props = {
  title?: string
  description?: string
  robots?: string
}

const {
  title = 'ChessBadger',
  description = 'Chess improvement, games, openings, and practical lessons.',
  robots,
} = Astro.props

const navItems = [
  { href: '/puzzles', label: 'Do Puzzles', primary: true },
  { href: '/leaderboard', label: 'Leaderboard' },
  { href: '/games', label: 'Games' },
  { href: '/articles', label: 'Articles' },
  { href: '/about', label: 'About' },
]

const isCurrent = (href: string) => Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`)
---

<!doctype html>
<html lang="en" class="bg-[#eef6ff] text-stone-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-badger-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-badger.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen antialiased">
    <header class="relative z-50 border-b border-stone-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex min-h-18 max-w-7xl items-center justify-between px-5 py-4 sm:px-6">
        <a href="/" class="text-xl font-black tracking-tight text-stone-950">
          ChessBadger
        </a>

        <nav class="hidden items-center gap-3 text-sm font-semibold text-stone-700 lg:flex">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-2.5 py-1.5 transition',
                item.primary ? 'font-bold text-amber-900 hover:text-amber-700' : 'hover:text-stone-950',
                isCurrent(item.href) && (item.primary ? 'bg-amber-50' : 'bg-stone-100 text-stone-950'),
              ]}
            >
              {item.label}
            </a>
          ))}
          <PlayerNav client:load />
        </nav>

        <details class="relative lg:hidden">
          <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-lg border border-stone-300 bg-white text-stone-900 transition hover:border-stone-500 [&::-webkit-details-marker]:hidden" aria-label="Open navigation menu">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </summary>
          <nav class="absolute right-0 z-30 mt-2 grid min-w-48 overflow-hidden rounded-xl border border-stone-200 bg-white py-2 text-sm font-semibold text-stone-800 shadow-xl shadow-stone-900/10">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'px-4 py-2.5 transition hover:bg-stone-50 hover:text-stone-950',
                  item.primary && 'font-bold text-amber-900 hover:bg-amber-50 hover:text-amber-700',
                  isCurrent(item.href) && (item.primary ? 'bg-amber-50' : 'bg-stone-100 text-stone-950'),
                ]}
              >
                {item.label}
              </a>
            ))}
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/players">Player sign in</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-8 text-sm text-stone-500">
        <span>© {new Date().getFullYear()} ChessBadger</span>
        <a href="/admin" class="hover:text-stone-800">Admin</a>
      </div>
    </footer>
  </body>
</html>
