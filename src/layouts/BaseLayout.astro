---
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
}

const {
  title = 'ChessBadger',
  description = 'Chess improvement, games, openings, and practical lessons.',
} = Astro.props
---

<!doctype html>
<html lang="en" class="bg-[#eef6ff] text-stone-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen antialiased">
    <header class="border-b border-stone-200 bg-white/85 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <a href="/" class="text-xl font-black tracking-tight text-stone-950">
          ChessBadger
        </a>

        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold text-stone-700 sm:justify-end">
          <a class="hover:text-stone-950" href="/">Home</a>
          <a class="hover:text-stone-950" href="/articles">Articles</a>
          <a class="hover:text-stone-950" href="/games">Games</a>
          <a class="hover:text-stone-950" href="/puzzles/steps-2-workbook">Puzzles</a>
          <a class="hover:text-stone-950" href="/about">About</a>
          <a class="hover:text-stone-950" href="/admin">Admin</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-stone-500">
        © {new Date().getFullYear()} ChessBadger
      </div>
    </footer>
  </body>
</html>
