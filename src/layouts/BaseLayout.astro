---
import '../styles/global.css'

type Props = {
  title?: string
  description?: string
}

const {
  title = 'ChessBadger',
  description = 'Chess improvement, games, openings, and practical lessons.',
} = Astro.props
---

<!doctype html>
<html lang="en" class="bg-[#eef6ff] text-stone-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen antialiased">
    <header class="border-b border-stone-200 bg-white/95 backdrop-blur">
      <div class="mx-auto flex min-h-18 max-w-7xl items-center justify-between px-5 py-4 sm:px-6">
        <a href="/" class="text-xl font-black tracking-tight text-stone-950">
          ChessBadger
        </a>

        <nav class="hidden items-center gap-6 text-sm font-semibold text-stone-700 lg:flex">
          <a class="hover:text-stone-950" href="/">Home</a>
          <a class="hover:text-stone-950" href="/articles">Articles</a>
          <a class="hover:text-stone-950" href="/games">Games</a>
          <a class="hover:text-stone-950" href="/puzzles">Puzzles</a>
          <a class="font-bold text-amber-900 hover:text-amber-700" href="/track-progress">Track My Progress</a>
          <a class="hover:text-stone-950" href="/about">About</a>
          <a class="hover:text-stone-950" href="/admin">Admin</a>
        </nav>

        <details class="relative lg:hidden">
          <summary class="grid size-11 cursor-pointer list-none place-items-center rounded-lg border border-stone-300 bg-white text-stone-900 transition hover:border-stone-500 [&::-webkit-details-marker]:hidden" aria-label="Open navigation menu">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-6 fill-none stroke-current" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
          </summary>
          <nav class="absolute right-0 z-30 mt-2 grid min-w-48 overflow-hidden rounded-xl border border-stone-200 bg-white py-2 text-sm font-semibold text-stone-800 shadow-xl shadow-stone-900/10">
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/">Home</a>
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/articles">Articles</a>
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/games">Games</a>
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/puzzles">Puzzles</a>
            <a class="px-4 py-2.5 font-bold text-amber-900 hover:bg-amber-50 hover:text-amber-700" href="/track-progress">Track My Progress</a>
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/about">About</a>
            <a class="px-4 py-2.5 hover:bg-stone-50 hover:text-stone-950" href="/admin">Admin</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-stone-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-stone-500">
        © {new Date().getFullYear()} ChessBadger
      </div>
    </footer>
  </body>
</html>
