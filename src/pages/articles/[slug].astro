---
import {sanityClient} from 'sanity:client'
import {PortableText} from 'astro-portabletext'
import BaseLayout from '../../layouts/BaseLayout.astro'

type Article = {
  title: string
  body?: unknown[]
}

export async function getStaticPaths() {
  const articles = await sanityClient.fetch<{slug: string}[]>(`
    *[_type == "article" && defined(slug.current)] {
      "slug": slug.current
    }
  `)

  return articles.map((article) => ({
    params: {
      slug: article.slug,
    },
  }))
}

const {slug} = Astro.params

const article = await sanityClient.fetch<Article>(
  `
    *[_type == "article" && slug.current == $slug][0] {
      title,
      body
    }
  `,
  {slug}
)
---

<BaseLayout title={`${article?.title ?? 'Article'} | ChessBadger`}>
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
      <p>
        <a href="/articles" class="text-sm font-bold text-amber-800 hover:text-stone-950">
          ← Back to articles
        </a>
      </p>

      {article ? (
        <>
          <p class="mt-10 text-sm font-black uppercase tracking-[0.24em] text-amber-800">
            ChessBadger Article
          </p>

          <h1 class="mt-4 text-5xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
            {article.title}
          </h1>
        </>
      ) : (
        <h1 class="mt-10 text-5xl font-black tracking-tight text-stone-950">
          Article not found
        </h1>
      )}
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-4xl px-6 py-16">
      {article ? (
        <article class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm sm:p-12">
          {Array.isArray(article.body) && article.body.length > 0 ? (
            <div class="article-prose">
              <PortableText value={article.body} />
            </div>
          ) : (
            <p class="text-lg text-stone-700">
              This article does not have body content yet.
            </p>
          )}
        </article>
      ) : (
        <p class="rounded-3xl border border-stone-200 bg-stone-50 p-8 text-lg text-stone-700">
          The article you’re looking for could not be found.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
