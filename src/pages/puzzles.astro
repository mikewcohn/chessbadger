---
import BaseLayout from '../layouts/BaseLayout.astro'
import PuzzleTrainer from '../components/PuzzleTrainer'
import { puzzles } from '../data/puzzles'
---

<BaseLayout title="Puzzle Trainer | ChessBadger" description="Practice chess puzzles on ChessBadger">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
      <p class="text-sm font-black uppercase tracking-[0.24em] text-amber-800">
        ChessBadger Puzzles
      </p>
      <h1 class="mt-4 max-w-3xl text-5xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
        Find the book move.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">
        Make one legal move. Your answer is checked automatically.
      </p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <PuzzleTrainer puzzles={puzzles} client:load />
    </div>
  </section>
</BaseLayout>
