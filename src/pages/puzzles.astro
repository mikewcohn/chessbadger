---
import BaseLayout from '../layouts/BaseLayout.astro'
import { puzzleCollections, steps2Workbook } from '../lib/puzzleCollections'

const legacyPuzzleRoutes = steps2Workbook.puzzles.map((puzzle) => {
  const section = steps2Workbook.sections.find((candidate) =>
    candidate.puzzles.some((sectionPuzzle) => sectionPuzzle.id === puzzle.id),
  )

  return section
    ? `/puzzles/${steps2Workbook.slug}/${section.slug}/puzzle/${puzzle.id}`
    : `/puzzles/${steps2Workbook.slug}`
})
---

<BaseLayout title="Puzzle Collections | ChessBadger" description="Choose a chess puzzle collection to practice">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-6 sm:py-11">
      <p class="text-sm font-bold tracking-[0.04em] text-amber-800">Puzzles</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-[1.04] tracking-[-0.025em] text-stone-950 sm:text-5xl">
        Choose a collection.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-stone-600">
        Work through a complete course or choose another collection as it becomes available.
      </p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto grid max-w-7xl gap-5 px-5 py-8 sm:px-6 sm:py-10 md:grid-cols-2">
      {puzzleCollections.map((collection) => (
        <a
          href={`/puzzles/${collection.slug}`}
          class="group rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:border-amber-300 hover:shadow-md sm:p-7"
        >
          <div class="flex items-start justify-between gap-5">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.12em] text-amber-800">Collection</p>
              <h2 class="mt-2 text-3xl font-bold tracking-[-0.02em] text-stone-950">{collection.title}</h2>
            </div>
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-amber-100 text-amber-900 transition group-hover:bg-amber-800 group-hover:text-white" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2.5">
                <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
          <p class="mt-4 text-stone-600">{collection.description}</p>
          <p class="mt-6 text-sm font-bold text-stone-500">
            {collection.sections.length} sections · {collection.puzzles.length} puzzles available
          </p>
        </a>
      ))}
    </div>
  </section>

  <script is:inline define:vars={{ legacyPuzzleRoutes }}>
    const params = new URLSearchParams(window.location.search)
    const collection = params.get('collection')
    const puzzleNumber = Number(params.get('puzzle'))

    if (collection === 'steps-2-workbook' && Number.isInteger(puzzleNumber) && puzzleNumber >= 1) {
      const destination = legacyPuzzleRoutes[puzzleNumber - 1]
      if (destination) {
        params.delete('collection')
        params.delete('puzzle')
        const query = params.toString()
        window.location.replace(`${destination}${query ? `?${query}` : ''}`)
      }
    }
  </script>
</BaseLayout>
