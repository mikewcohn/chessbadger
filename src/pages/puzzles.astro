---
import BaseLayout from '../layouts/BaseLayout.astro'
import PuzzleTrainer from '../components/PuzzleTrainer'
import { steps2Workbook } from '../data/puzzleCollections'
---

<BaseLayout title="Puzzle Trainer | ChessBadger" description="Practice chess puzzles on ChessBadger">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-7 sm:py-9">
      <p class="text-sm font-black tracking-[0.08em] text-amber-800">
        Puzzles
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl font-black leading-tight tracking-tight text-stone-950 sm:text-5xl">
        Find the right move.
      </h1>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8">
      <PuzzleTrainer
        puzzles={steps2Workbook.puzzles}
        collectionName={steps2Workbook.title}
        collectionSlug={steps2Workbook.slug}
        client:load
      />
    </div>
  </section>
</BaseLayout>
