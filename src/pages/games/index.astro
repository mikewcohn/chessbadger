---
import BaseLayout from '../../layouts/BaseLayout.astro'
import FormattedDate from '../../components/FormattedDate.astro'
import { sanityClient } from '../../lib/sanity'

type Game = {
  title: string
  slug: string
  white?: string
  black?: string
  playedOn?: string
  event?: string
  result?: string
}

const games = await sanityClient.fetch<Game[]>(`
  *[_type == "game" && defined(slug.current)] | order(playedOn desc, title asc) {
    title,
    "slug": slug.current,
    white,
    black,
    playedOn,
    event,
    result
  }
`)
---

<BaseLayout title="Games | ChessBadger" description="Chess games on ChessBadger">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <p class="text-sm font-black uppercase tracking-[0.24em] text-amber-800">
        ChessBadger Games
      </p>

      <h1 class="mt-4 max-w-3xl text-5xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
        Replay practical games move by move.
      </h1>

      <p class="mt-6 max-w-2xl text-xl leading-8 text-stone-700">
        Browse full PGNs, results, events, and player details in one place.
      </p>
    </div>
  </section>

  <section class="bg-stone-950 text-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      {games.length === 0 ? (
        <p class="rounded-3xl border border-white/10 bg-white/5 p-6 text-stone-300">
          No games have been published yet.
        </p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {games.map((game) => (
            <a
              href={`/games/${game.slug}/`}
              class="group rounded-3xl border border-white/10 bg-white p-7 text-stone-950 shadow-xl transition hover:-translate-y-1 hover:bg-amber-100"
            >
              <p class="text-sm font-black uppercase tracking-[0.2em] text-amber-800">
                Game
              </p>

              <h2 class="mt-5 text-2xl font-black leading-tight tracking-tight">
                {game.title}
              </h2>

              <p class="mt-5 text-base font-semibold text-stone-700">
                {game.white || 'White'} vs. {game.black || 'Black'}
                {game.result ? ` - ${game.result}` : ''}
              </p>

              {(game.event || game.playedOn) && (
                <p class="mt-3 text-sm text-stone-600">
                  {game.event}
                  {game.event && game.playedOn ? ' · ' : ''}
                  {game.playedOn && <FormattedDate date={game.playedOn} />}
                </p>
              )}

              <p class="mt-8 text-sm font-bold text-stone-600 group-hover:text-stone-950">
                Replay game
              </p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
