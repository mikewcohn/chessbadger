---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PuzzleCollectionProgress from '../../components/PuzzleCollectionProgress'
import { steps2Workbook } from '../../data/puzzleCollections'
---

<BaseLayout title="Steps 2 Workbook | ChessBadger" description="Track progress through the Steps 2 Workbook puzzles">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-7 sm:py-9">
      <p class="text-sm font-black tracking-[0.08em] text-amber-800">Puzzles</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
        {steps2Workbook.title}
      </h1>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <PuzzleCollectionProgress collection={steps2Workbook} client:load />
    </div>
  </section>
</BaseLayout>
