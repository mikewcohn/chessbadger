---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PuzzleCollectionProgress from '../../components/PuzzleCollectionProgress'
import { polgar5334 } from '../../data/puzzleCollections'
---

<BaseLayout
  title="5334 Problems, Combinations, and Games | ChessBadger"
  description="Track progress through László Polgár’s 5334 Problems, Combinations, and Games"
>
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-7 sm:py-9">
      <p class="text-sm font-black tracking-[0.08em] text-amber-800">
        <a href="/puzzles" class="hover:text-amber-700">Puzzles</a>
        <span class="mx-2 text-stone-400" aria-hidden="true">/</span>
        Collection
      </p>
      <h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
        {polgar5334.title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-stone-600">{polgar5334.description}</p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <PuzzleCollectionProgress collection={polgar5334} client:load />
    </div>
  </section>
</BaseLayout>
