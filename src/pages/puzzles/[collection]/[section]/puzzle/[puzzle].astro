---
import BaseLayout from '../../../../../layouts/BaseLayout.astro'
import PuzzleTrainer from '../../../../../components/PuzzleTrainer'
import { puzzleCollections, type PuzzleCollection, type PuzzleSection } from '../../../../../lib/puzzleCollections'
import type { Puzzle } from '../../../../../types/puzzles'

export function getStaticPaths() {
  return puzzleCollections.flatMap((collection) => collection.sections.flatMap((section) =>
    section.puzzles.map((puzzle) => ({
      params: { collection: collection.slug, section: section.slug, puzzle: puzzle.id },
      props: { collection, section, puzzle },
    })),
  ))
}

type Props = {
  collection: PuzzleCollection
  section: PuzzleSection
  puzzle: Puzzle
}

const { collection, section, puzzle } = Astro.props
---

<BaseLayout title={`${puzzle.title} | ${section.title} | ChessBadger`} description={`Practice ${puzzle.title} from ${collection.title}`}>
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 sm:py-7">
      <PuzzleTrainer
        puzzles={section.puzzles}
        collectionName={collection.title}
        collectionSlug={collection.slug}
        sectionName={section.title}
        sectionSlug={section.slug}
        initialPuzzleId={puzzle.id}
        client:load
      />
    </div>
  </section>
</BaseLayout>
