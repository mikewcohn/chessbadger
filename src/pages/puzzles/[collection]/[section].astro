---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PuzzleSectionProgress from '../../../components/PuzzleSectionProgress'
import { puzzleCollections, type PuzzleCollection, type PuzzleSection } from '../../../data/puzzleCollections'

export function getStaticPaths() {
  return puzzleCollections.flatMap((collection) => collection.sections.map((section) => ({
    params: { collection: collection.slug, section: section.slug },
    props: { collection, section },
  })))
}

type Props = {
  collection: PuzzleCollection
  section: PuzzleSection
}

const { collection, section } = Astro.props
---

<BaseLayout title={`${section.title} | ${collection.title} | ChessBadger`} description={section.description}>
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-6 sm:py-10">
      <p class="text-sm font-bold tracking-[0.04em] text-amber-800">
        <a href="/puzzles" class="hover:text-amber-700">Puzzles</a>
        <span class="mx-2 text-stone-400" aria-hidden="true">/</span>
        <a href={`/puzzles/${collection.slug}`} class="hover:text-amber-700">{collection.title}</a>
      </p>
      <p class="mt-4 text-xs font-bold uppercase tracking-[0.12em] text-stone-500">{section.workbookPages}</p>
      <h1 class="mt-2 max-w-5xl text-4xl font-bold leading-[1.04] tracking-[-0.025em] text-stone-950 sm:text-5xl">{section.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-stone-600">{section.description}</p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-7xl px-5 py-8 sm:px-6 sm:py-10">
      <PuzzleSectionProgress collection={collection} section={section} client:load />
    </div>
  </section>
</BaseLayout>
