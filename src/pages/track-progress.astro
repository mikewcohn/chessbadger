---
import BaseLayout from '../layouts/BaseLayout.astro'
import TrackProgress from '../components/TrackProgress'
---

<BaseLayout title="Track My Progress | ChessBadger" description="Create private ChessBadger practice and coach results links">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-5 py-10 sm:px-6 sm:py-14">
      <p class="text-sm font-bold tracking-[0.04em] text-amber-800">Track My Progress</p>
      <h1 class="mt-3 max-w-4xl text-4xl font-bold leading-[1.04] tracking-[-0.025em] text-stone-950 sm:text-6xl">
        Keep your puzzle history. Share it with your coach.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-600">
        Create private links without setting up a password or providing an email address.
      </p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-5xl px-5 py-10 sm:px-6 sm:py-14">
      <TrackProgress client:load />
    </div>
  </section>
</BaseLayout>
