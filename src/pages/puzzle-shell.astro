---
import BaseLayout from '../layouts/BaseLayout.astro'
import PuzzleTrainerLoader from '../components/PuzzleTrainerLoader'
---

<BaseLayout title="Puzzle | ChessBadger" description="Practice a ChessBadger puzzle">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-[96rem] px-4 py-5 sm:px-6 sm:py-7">
      <PuzzleTrainerLoader client:only="react">
        <div slot="fallback" class="mx-auto max-w-5xl animate-pulse rounded-2xl border border-stone-200 bg-white p-8 shadow-sm" aria-label="Loading puzzle">
          <div class="h-5 w-48 rounded bg-stone-200"></div>
          <div class="mt-5 h-10 w-72 max-w-full rounded bg-stone-200"></div>
          <div class="mt-8 aspect-square w-full max-w-xl rounded-xl bg-stone-200"></div>
        </div>
      </PuzzleTrainerLoader>
    </div>
  </section>
</BaseLayout>
