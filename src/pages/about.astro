---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PortableText } from 'astro-portabletext'
import { sanityClient } from '../lib/sanity'

const aboutPage = await sanityClient.fetch(`
	*[_type == "aboutPage"][0] {
		title,
		description,
		body
	}
`)

const title = aboutPage?.title || 'About ChessBadger'
const description = aboutPage?.description || 'Learn more about ChessBadger.'
const body = aboutPage?.body || []
---

<BaseLayout title={title} description={description}>
	<section class="bg-[#eef6ff]">
		<div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
			<p class="text-sm font-black uppercase tracking-[0.24em] text-amber-800">
				About
			</p>

			<h1 class="mt-4 text-5xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
				{title}
			</h1>

			<p class="mt-6 max-w-2xl text-xl leading-8 text-stone-700">
				{description}
			</p>
		</div>
	</section>

	<section class="bg-white">
		<div class="mx-auto max-w-4xl px-6 py-16">
			<article class="rounded-3xl border border-stone-200 bg-white p-8 shadow-sm sm:p-12">
				{body.length > 0 ? (
					<div class="article-prose">
						<PortableText value={body} />
					</div>
				) : (
					<p class="text-lg text-stone-700">This page is coming soon.</p>
				)}
			</article>
		</div>
	</section>
</BaseLayout>
