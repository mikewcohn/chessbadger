---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PortableText } from 'astro-portabletext'
import { sanityClient } from '../lib/sanity'

const aboutPage = await sanityClient.fetch(`
	*[_type == "aboutPage"][0] {
		title,
		description,
		body
	}
`)

const title = aboutPage?.title || 'About ChessBadger'
const description = aboutPage?.description || 'Learn more about ChessBadger.'
const body = aboutPage?.body || []
---

<BaseLayout title={title} description={description}>
	<main class="about-page">
		<h1>{title}</h1>

		{body.length > 0 ? (
			<div class="about-content">
				<PortableText value={body} />
			</div>
		) : (
			<p>This page is coming soon.</p>
		)}
	</main>
</BaseLayout>

<style>
	.about-page {
		max-width: 760px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.about-page h1 {
		margin-bottom: 1rem;
	}

	.about-content {
		line-height: 1.6;
	}

	.about-content p,
	.about-content ul,
	.about-content ol,
	.about-content blockquote {
		margin-bottom: 1rem;
	}

	.about-content h2 {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
	}

	.about-content h3 {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.about-content blockquote {
		border-left: 4px solid var(--accent);
		padding-left: 1rem;
		font-style: italic;
	}
</style>