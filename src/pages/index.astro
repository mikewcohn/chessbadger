---
import {sanityClient} from 'sanity:client'
import {PortableText} from 'astro-portabletext'
import type {PortableTextBlock} from '@portabletext/types'
import BaseLayout from '../layouts/BaseLayout.astro'
import {puzzleCollections} from '../lib/puzzleCollections'

type HomePage = {
  eyebrow?: string
  heroTitle?: string
  intro?: string
  heroImage?: {
    asset?: {
      url?: string
    }
    alt?: string
  }
  body?: PortableTextBlock[]
}

type Article = {
  _id: string
  title: string
  slug: {
    current: string
  }
}

const homePage = await sanityClient.fetch<HomePage>(`
  *[_id == "homePage"][0] {
    eyebrow,
    heroTitle,
    intro,
    heroImage {
      asset-> {
        url
      },
      alt
    },
    body
  }
`)

const articles = await sanityClient.fetch<Article[]>(`
  *[_type == "article" && defined(slug.current)] | order(_createdAt desc)[0...3] {
    _id,
    title,
    slug
  }
`)

const heroTitle = homePage?.heroTitle ?? 'Practical chess improvement for real games.'
const punctuatedHeroTitle = heroTitle.endsWith('.') ? heroTitle : `${heroTitle}.`
const totalPuzzles = puzzleCollections.reduce((total, collection) => total + collection.puzzles.length, 0)
const totalSections = puzzleCollections.reduce((total, collection) => total + collection.sections.length, 0)
const pageDescription = `Practice ${totalPuzzles.toLocaleString('en-US')} chess puzzles in structured collections, track your progress, and read practical chess lessons.`
---

<BaseLayout title="ChessBadger" description={pageDescription} image={homePage?.heroImage?.asset?.url}>
  <section class="bg-[#eef6ff]">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:py-28">
      <div>
        <p class="mb-5 text-sm font-black uppercase tracking-[0.24em] text-amber-800">
          {homePage?.eyebrow ?? 'Welcome to ChessBadger'}
        </p>

        <h1 class="max-w-4xl text-5xl font-bold leading-[0.98] tracking-tight text-stone-950 sm:text-6xl lg:text-7xl">
          {punctuatedHeroTitle}
        </h1>

        <p class="mt-7 max-w-2xl text-xl leading-8 text-stone-700">
          {homePage?.intro ?? 'Lessons, games, openings, and practical ideas for players who want to get better without drowning in theory.'}
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/puzzles"
            class="inline-flex items-center gap-2 rounded-full bg-amber-800 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-amber-950/15 transition hover:bg-amber-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-800"
          >
            Do Puzzles
            <svg viewBox="0 0 24 24" aria-hidden="true" class="size-4 fill-none stroke-current" stroke-width="2.5">
              <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>

          <a
            href="/articles"
            class="rounded-full border border-stone-300 bg-white px-6 py-3 text-sm font-bold text-stone-900 transition hover:border-stone-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-950"
          >
            Read Articles
          </a>
        </div>

        <p class="mt-6 text-sm font-semibold text-stone-600">
          {totalPuzzles.toLocaleString('en-US')} puzzles across {totalSections} focused sections.
        </p>
      </div>

      <div class="rounded-[2rem] border border-stone-300 bg-white p-4 shadow-2xl shadow-stone-900/10">
        {homePage?.heroImage?.asset?.url ? (
          <img
            src={homePage.heroImage.asset.url}
            alt={homePage.heroImage.alt ?? ''}
            class="aspect-square w-full rounded-[1.4rem] object-cover"
          />
        ) : (
          <div class="grid aspect-square grid-cols-8 overflow-hidden rounded-[1.4rem] border border-stone-200">
            {Array.from({length: 64}).map((_, index) => {
              const row = Math.floor(index / 8)
              const col = index % 8
              const dark = (row + col) % 2 === 1

              return (
                <div class={dark ? 'bg-amber-900' : 'bg-amber-100'}></div>
              )
            })}
          </div>
        )}

      </div>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="practice-heading">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.2em] text-amber-800">Practice</p>
          <h2 id="practice-heading" class="mt-3 max-w-3xl text-4xl font-black tracking-tight text-stone-950 sm:text-5xl">
            Choose your next challenge.
          </h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-stone-600">
            Follow a structured workbook, sharpen a specific skill, or practice mixed positions without a hint.
          </p>
        </div>

        <a href="/puzzles" class="shrink-0 text-sm font-bold text-amber-900 underline decoration-amber-300 decoration-2 underline-offset-4 hover:text-amber-700">
          View all collections
        </a>
      </div>

      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {puzzleCollections.map((collection, index) => (
          <a
            href={`/puzzles/${collection.slug}`}
            class:list={[
              'group flex min-h-64 flex-col rounded-3xl border p-7 transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-800',
              index === 0
                ? 'border-amber-200 bg-amber-50 shadow-lg shadow-amber-950/5 hover:border-amber-300 hover:shadow-xl'
                : 'border-stone-200 bg-stone-50 hover:border-stone-300 hover:bg-white hover:shadow-lg',
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <p class="text-xs font-black uppercase tracking-[0.16em] text-amber-800">
                {index === 0 ? 'Start here' : 'Collection'}
              </p>
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-white text-amber-900 shadow-sm transition group-hover:translate-x-1" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="2.5">
                  <path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>

            <h3 class="mt-5 text-2xl font-black leading-tight tracking-tight text-stone-950">
              {collection.title}
            </h3>
            <p class="mt-3 text-stone-600">{collection.description}</p>
            <p class="mt-auto pt-7 text-sm font-bold text-stone-500">
              {collection.sections.length} sections · {collection.puzzles.length.toLocaleString('en-US')} puzzles
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {Array.isArray(homePage?.body) && homePage.body.length > 0 && (
    <section class="bg-stone-100">
      <div class="mx-auto max-w-4xl px-6 py-16">
        <div class="rounded-3xl border border-stone-200 bg-stone-50 p-8 text-lg leading-8 text-stone-700 shadow-sm">
          <PortableText value={homePage.body} />
        </div>
      </div>
    </section>
  )}

  <section class="bg-stone-950 text-white">
    <div class="mx-auto max-w-6xl px-6 py-20">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-black uppercase tracking-[0.24em] text-amber-300">
            Latest
          </p>
          <h2 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">
            Recent Articles
          </h2>
        </div>

        <a href="/articles" class="text-sm font-bold text-amber-300 hover:text-amber-200">
          View all articles →
        </a>
      </div>

      {articles.length === 0 ? (
        <p class="mt-10 rounded-3xl border border-white/10 bg-white/5 p-6 text-stone-300">
          No articles have been published yet.
        </p>
      ) : (
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {articles.map((article) => (
            <a
              href={`/articles/${article.slug.current}`}
              class="group rounded-3xl border border-white/10 bg-white p-7 text-stone-950 shadow-xl transition hover:-translate-y-1 hover:bg-amber-100"
            >
              <p class="text-sm font-black uppercase tracking-[0.2em] text-amber-800">
                Article
              </p>

              <h3 class="mt-5 text-2xl font-black leading-tight tracking-tight">
                {article.title}
              </h3>

              <p class="mt-8 text-sm font-bold text-stone-600 group-hover:text-stone-950">
                Read article →
              </p>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
