---
import {sanityClient} from 'sanity:client'
import {PortableText} from 'astro-portabletext'
import BaseLayout from '../layouts/BaseLayout.astro'

type HomePage = {
  eyebrow?: string
  heroTitle?: string
  intro?: string
  body?: unknown[]
}

type Article = {
  _id: string
  title: string
  slug: {
    current: string
  }
}

const homePage = await sanityClient.fetch<HomePage>(`
  *[_type == "homePage"][0] {
    eyebrow,
    heroTitle,
    intro,
    body
  }
`)

const articles = await sanityClient.fetch<Article[]>(`
  *[_type == "article" && defined(slug.current)] | order(_createdAt desc)[0...3] {
    _id,
    title,
    slug
  }
`)
---

<BaseLayout title="ChessBadger">
  <section class="hero">
    <div class="container">
      <div class="hero-card">
        <p class="eyebrow">{homePage?.eyebrow ?? 'Welcome to ChessBadger'}</p>

        <h1>{homePage?.heroTitle ?? 'Practical Chess Improvement'}</h1>

        <p class="lede">
          {homePage?.intro ?? 'Edit this homepage in Sanity Studio by creating a Home Page document.'}
        </p>
      </div>
    </div>
  </section>

  {Array.isArray(homePage?.body) && homePage.body.length > 0 && (
    <section class="section">
      <div class="container prose">
        <PortableText value={homePage.body} />
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>Latest Articles</h2>

      {articles.length === 0 ? (
        <p>No articles have been published yet.</p>
      ) : (
        <ul class="card-list">
          {articles.map((article) => (
            <li>
              <a class="article-card" href={`/articles/${article.slug.current}`}>
                {article.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>