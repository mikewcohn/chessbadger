---
import BaseLayout from '../layouts/BaseLayout.astro'
import SharedProgress from '../components/SharedProgress'
import { puzzles } from '../data/puzzles'

const workbookPuzzles = puzzles.map(({ id, title }) => ({ id, title }))
---

<BaseLayout title="Coach Review | ChessBadger" description="Review puzzle attempts on ChessBadger">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-5 py-9 sm:px-6 sm:py-11">
      <h1 class="text-4xl font-bold leading-tight tracking-[-0.025em] text-stone-950 sm:text-5xl">Coach review</h1>
      <p class="mt-3 text-stone-600">Puzzle progress and results at a glance.</p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <SharedProgress workbookPuzzles={workbookPuzzles} client:load />
    </div>
  </section>
</BaseLayout>
