---
import BaseLayout from '../layouts/BaseLayout.astro'
import SharedProgress from '../components/SharedProgress'
---

<BaseLayout title="Coach Review | ChessBadger" description="Review puzzle attempts on ChessBadger">
  <section class="bg-[#eef6ff]">
    <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
      <h1 class="max-w-3xl text-5xl font-black leading-tight tracking-tight text-stone-950 sm:text-6xl">
        Puzzle results for coach review.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-stone-700">
        Review every checked move, along with solving time, pauses, and restarts.
      </p>
    </div>
  </section>

  <section class="bg-stone-100">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
      <SharedProgress client:load />
    </div>
  </section>
</BaseLayout>
